root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
end_of_line = lf
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.cs]
end_of_line = crlf
indent_size = 4
